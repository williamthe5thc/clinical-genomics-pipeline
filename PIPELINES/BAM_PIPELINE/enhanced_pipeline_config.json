{
  "comment": "Enhanced Clinical Genomics Pipeline Configuration",
  "version": "1.0",
  "last_updated": "2025-01-22",
  
  "processing_settings": {
    "max_threads": 8,
    "memory_limit_gb": 64,
    "processing_timeout_hours": 4,
    "enable_bam_processing": true,
    "enable_sv_calling": true,
    "enable_cnv_calling": true,
    "enable_trio_analysis": true
  },
  
  "output_settings": {
    "output_formats": ["html", "json", "csv"],
    "generate_plots": true,
    "include_quality_metrics": true,
    "compress_output": true
  },
  
  "quality_thresholds": {
    "min_mapping_quality": 20,
    "min_coverage_20x": 95.0,
    "min_coverage_30x": 90.0,
    "max_contamination": 3.0,
    "min_on_target_percent": 80.0
  },
  
  "tool_paths": {
    "samtools": "/usr/bin/samtools",
    "mosdepth": "/usr/local/bin/mosdepth", 
    "manta": "/usr/local/bin/configManta.py",
    "gatk": "/usr/local/bin/gatk",
    "vep": "/usr/local/bin/vep"
  },
  
  "database_paths": {
    "reference_genome": "/mnt/d/Genome/databases/reference/Homo_sapiens.GRCh38.dna.primary_assembly.fa",
    "clinical_genes_bed": "/mnt/d/Genome/databases/clinical_panels/915_gene_panel.bed",
    "vep_cache": "/mnt/d/Genome/databases/vep_cache",
    "gnomad": "/mnt/d/Genome/databases/gnomad",
    "clinvar": "/mnt/d/Genome/databases/clinvar",
    "alphamissense": "/mnt/d/Genome/databases/alphamissense"
  },
  
  "clinical_settings": {
    "specialties_enabled": 22,
    "total_genes": 915,
    "acmg_strict_mode": true,
    "require_clinical_validation": true,
    "generate_secondary_findings": true
  }
}
